# DG-LETS Agri Market — Mobile App Environment Variables
# Copy to .env and fill in your values

# Backend API URL
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1

# Google Maps (for Smart Map feature)
EXPO_PUBLIC_GOOGLE_MAPS_KEY=REPLACE_WITH_YOUR_KEY

# EAS Build
EAS_PROJECT_ID=REPLACE_WITH_YOUR_EAS_PROJECT_ID
