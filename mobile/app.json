{
  "expo": {
    "name": "DG-LETS Agri Market",
    "slug": "dglets-agri-market",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1e5c3a"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.dglets.agrimarket",
      "buildNumber": "1",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Allow DG-LETS to use your location to find nearby farmers.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Allow DG-LETS to use your location to find nearby farmers.",
        "NSCameraUsageDescription": "Allow DG-LETS to access your camera for product images.",
        "NSPhotoLibraryUsageDescription": "Allow DG-LETS to access your photos for product images.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1e5c3a"
      },
      "package": "com.dglets.agrimarket",
      "versionCode": 2,
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE"
      ]
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#1e5c3a",
          "sounds": []
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow DG-LETS to use your location to find nearby farmers."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow DG-LETS to access your photos for product images.",
          "cameraPermission": "Allow DG-LETS to access your camera for product images."
        }
      ]
    ],
    "scheme": "dglets",
    "extra": {
      "eas": {
        "projectId": "b1b43a34-d965-4e2a-96e2-a1d52b9cd7c1"
      }
    },
    "owner": "devdanielcodes357"
  }
}
