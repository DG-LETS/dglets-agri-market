# DG-LETS Agri Market — Production Environment
# These values are set as Railway environment variables — do not commit secrets

NODE_ENV=production
PORT=3000
CORS_ORIGIN=*

# Set by Railway automatically when PostgreSQL plugin is added:
# DATABASE_URL=postgresql://...

# JWT — set strong random secrets in Railway dashboard
JWT_SECRET=REPLACE_IN_RAILWAY_DASHBOARD
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=REPLACE_IN_RAILWAY_DASHBOARD
JWT_REFRESH_EXPIRES_IN=30d

# OTP
OTP_EXPIRES_MINUTES=10
BCRYPT_ROUNDS=12

# SMS (Termii)
TERMII_API_KEY=
TERMII_SENDER_ID=DG-LETS
TERMII_BASE_URL=https://api.ng.termii.com

# Payments (Paystack)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_CALLBACK_URL=https://YOUR_RAILWAY_URL/api/v1/payments/paystack/callback

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Platform fees
PLATFORM_FEE_RATE=0.0205
PLATFORM_FEE_MIN=200
PLATFORM_FEE_CAP=50000

REGISTRATION_FEE_FARMER=2000
REGISTRATION_FEE_TRADER=2000
REGISTRATION_FEE_AGGREGATOR=2000
REGISTRATION_FEE_PROCESSOR=2000
REGISTRATION_FEE_EXPORTER=5000
REGISTRATION_FEE_HAULAGE=3000
REGISTRATION_FEE_BUYER=0

HAULAGE_COMMISSION_RATE=0.05
