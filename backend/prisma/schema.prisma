// DG-LETS Agri Market — Prisma Schema
// Run: npx prisma migrate dev --name init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════
// ENUMS
// ═══════════════════════════════════════

enum UserRole {
  FARMER
  BUYER
  TRADER
  AGGREGATOR
  PROCESSOR
  EXPORTER
  HAULAGE
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  PAUSED
  SOLD_OUT
  DELETED
}

enum OrderStatus {
  DRAFT
  PENDING
  PENDING_PAYMENT
  PAYMENT_PROCESSING
  PAID
  SELLER_CONFIRMED
  CONFIRMED
  PROCESSING
  READY_FOR_PICKUP
  PICKED_UP
  IN_TRANSIT
  DELIVERED
  BUYER_CONFIRMED
  COMPLETED
  CANCELLED
  DISPUTED
  REFUND_PENDING
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentStatus {
  INITIATED
  PENDING
  PROCESSING
  PAID
  SUCCESS
  FAILED
  CANCELLED
  REFUND_PENDING
  REFUNDED
  PARTIALLY_REFUNDED
  DISPUTED
}

enum SettlementStatus {
  PENDING_DELIVERY
  ELIGIBLE_FOR_SETTLEMENT
  SETTLED
  HELD
}

enum LedgerEntryType {
  BUYER_PAYMENT
  MARKETPLACE_COMMISSION
  PAYMENT_PROCESSING_FEE
  SELLER_PROCEEDS
  LOGISTICS_PAYMENT
  LOGISTICS_MARGIN
  REFUND
  CHARGEBACK
  ADJUSTMENT
}

enum NotificationType {
  ORDER
  PAYMENT
  MESSAGE
  VERIFICATION
  DELIVERY
  REWARD
  SYSTEM
  MARKET_PRICE
}

// ═══════════════════════════════════════
// IDENTITY
// ═══════════════════════════════════════

model User {
  id              String     @id @default(uuid())
  email           String?    @unique
  phone           String     @unique
  passwordHash    String?
  role            UserRole   @default(BUYER)
  status          UserStatus @default(PENDING_VERIFICATION)
  firstName       String
  lastName        String
  profileImage    String?
  referralCode    String     @unique @default(uuid())
  referredBy      String?
  pushToken       String?
  lastLoginAt     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  // Relations
  farmerProfile   FarmerProfile?
  buyerProfile    BuyerProfile?
  haulageProfile  HaulageProfile?
  otpTokens       OtpToken[]
  refreshTokens   RefreshToken[]
  products        Product[]
  ordersAsBuyer   Order[]        @relation("BuyerOrders")
  ordersAsSeller  Order[]        @relation("SellerOrders")
  sentMessages    Message[]      @relation("SentMessages")
  notifications   Notification[]
  reviews         Review[]       @relation("ReviewAuthor")
  receivedReviews Review[]       @relation("ReviewSubject")
  rewardWallet    RewardWallet?
  savedProducts   SavedProduct[]
  verification    Verification?
  auditLogs       AuditLog[]
  haulageApplications HaulageApplication[] @relation("HaulageApplications")
  awardedHaulageJobs  HaulageJob[]         @relation("AwardedHaulageJobs")
  platformFees        PlatformFee[]
  ledgerEntries       TransactionLedger[]
  buyerRequests       BuyerRequest[]       @relation("BuyerRequests")
  sellerOffers        SellerOffer[]        @relation("SellerOffers")

  @@map("users")
}

model FarmerProfile {
  id                String   @id @default(uuid())
  userId            String   @unique
  farmName          String?
  farmLocation      String?
  state             String
  lga               String?
  geoLat            Float?
  geoLng            Float?
  products          String[]
  productionCapacity String?
  farmSize          String?
  farmImages        String[]
  bio               String?
  yearsOfFarming    Int?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("farmer_profiles")
}

model BuyerProfile {
  id           String   @id @default(uuid())
  userId       String   @unique
  businessName String?
  buyerType    String?
  state        String?
  lga          String?
  address      String?
  geoLat       Float?
  geoLng       Float?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("buyer_profiles")
}

// ═══════════════════════════════════════
// AUTH TOKENS
// ═══════════════════════════════════════

model OtpToken {
  id        String   @id @default(uuid())
  userId    String
  token     String
  purpose   String   // verify_phone | reset_password | verify_email
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("otp_tokens")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// ═══════════════════════════════════════
// MARKETPLACE
// ═══════════════════════════════════════

model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  slug        String    @unique
  description String?
  icon        String?
  image       String?
  isActive    Boolean   @default(true)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  products Product[]

  @@map("categories")
}

model Product {
  id               String        @id @default(uuid())
  sellerId         String
  categoryId       String
  name             String
  slug             String
  description      String?
  price            Float
  priceUnit        String        @default("kg")
  quantity         Float
  quantityUnit     String        @default("kg")
  moq              Float         @default(1)
  qualityGrade     String?
  harvestDate      DateTime?
  processingStatus String?
  state            String
  lga              String?
  geoLat           Float?
  geoLng           Float?
  deliveryAvailable Boolean     @default(false)
  images           String[]
  status           ProductStatus @default(DRAFT)
  viewCount        Int           @default(0)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  seller     User       @relation(fields: [sellerId], references: [id])
  category   Category   @relation(fields: [categoryId], references: [id])
  orderItems OrderItem[]
  savedBy    SavedProduct[]
  reviews    Review[]

  @@index([sellerId])
  @@index([categoryId])
  @@index([status])
  @@index([state])
  @@map("products")
}

model SavedProduct {
  id        String   @id @default(uuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("saved_products")
}

// ═══════════════════════════════════════
// ORDERS
// ═══════════════════════════════════════

model Order {
  id                    String           @id @default(uuid())
  orderNumber           String           @unique
  buyerId               String
  sellerId              String
  status                OrderStatus      @default(PENDING)
  paymentStatus         PaymentStatus    @default(PENDING)
  settlementStatus      SettlementStatus @default(PENDING_DELIVERY)

  // Financial snapshot at time of order creation (Section 4 & 13)
  currency              String           @default("NGN")
  subtotal              Float            // product_subtotal = Σ(quantity × unit_price)
  commissionRate        Float            @default(0.05) // snapshot commission rate (e.g. 0.05)
  commissionAmount      Float            @default(0)    // marketplace_commission = subtotal * commissionRate
  logisticsBaseCost     Float            @default(0)    // logistics provider quote / actual cost
  logisticsMargin       Float            @default(0)    // DG-LETS logistics margin
  deliveryFee           Float            @default(0)    // logisticsBaseCost + logisticsMargin (paid by buyer)
  paymentProcessingFee  Float            @default(0)    // payment gateway processing fee
  buyerTotal            Float            // subtotal + deliveryFee
  sellerGross           Float            // subtotal
  sellerNet             Float            // subtotal - commissionAmount
  dgLetsRevenue         Float            @default(0)    // commissionAmount + logisticsMargin
  refundAmount          Float            @default(0)
  platformFee           Float            @default(0)    // backward compatibility alias for commissionAmount
  total                 Float            // backward compatibility alias for buyerTotal

  deliveryAddress       String?
  deliveryState         String?
  notes                 String?
  paidAt                DateTime?
  confirmedAt           DateTime?
  settledAt             DateTime?
  completedAt           DateTime?
  cancelledAt           DateTime?
  cancelReason          String?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  buyer         User                @relation("BuyerOrders",  fields: [buyerId],  references: [id])
  seller        User                @relation("SellerOrders",  fields: [sellerId], references: [id])
  items         OrderItem[]
  payment       Payment?
  reviews       Review[]
  haulageJob    HaulageJob?
  ledgerEntries TransactionLedger[]

  @@index([buyerId])
  @@index([sellerId])
  @@index([status])
  @@index([settlementStatus])
  @@map("orders")
}

model OrderItem {
  id        String   @id @default(uuid())
  orderId   String
  productId String
  quantity  Float
  unitPrice Float
  subtotal  Float
  createdAt DateTime @default(now())

  order   Order   @relation(fields: [orderId],   references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@map("order_items")
}

// ═══════════════════════════════════════
// PAYMENTS
// ═══════════════════════════════════════

model Payment {
  id                   String        @id @default(uuid())
  orderId              String        @unique
  amount               Float
  currency             String        @default("NGN")
  provider             String        // paystack | flutterwave
  providerRef          String?       @unique
  idempotencyKey       String?       @unique
  status               PaymentStatus @default(PENDING)
  commissionAmount     Float         @default(0)
  sellerAmount         Float         @default(0)
  logisticsAmount      Float         @default(0)
  paymentProcessingFee Float         @default(0)
  platformFee          Float         @default(0) // alias for commissionAmount
  metadata             Json?
  paidAt               DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  order Order @relation(fields: [orderId], references: [id])

  @@map("payments")
}

// ═══════════════════════════════════════
// MESSAGING
// ═══════════════════════════════════════

model Conversation {
  id           String    @id @default(uuid())
  participants String[]
  productId    String?
  orderId      String?
  lastMessageAt DateTime?
  createdAt    DateTime  @default(now())

  messages Message[]

  @@map("conversations")
}

model Message {
  id             String   @id @default(uuid())
  conversationId String
  senderId       String
  body           String
  attachments    String[]
  readAt         DateTime?
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("SentMessages", fields: [senderId], references: [id])

  @@index([conversationId])
  @@map("messages")
}

// ═══════════════════════════════════════
// TRUST & REPUTATION
// ═══════════════════════════════════════

model Verification {
  id               String             @id @default(uuid())
  userId           String             @unique
  phoneVerified    Boolean            @default(false)
  emailVerified    Boolean            @default(false)
  identityStatus   VerificationStatus @default(UNVERIFIED)
  businessStatus   VerificationStatus @default(UNVERIFIED)
  farmStatus       VerificationStatus @default(UNVERIFIED)
  identityDocUrl   String?
  businessDocUrl   String?
  farmDocUrl       String?
  reviewedBy       String?
  reviewedAt       DateTime?
  rejectionReason  String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("verifications")
}

model Review {
  id          String   @id @default(uuid())
  orderId     String
  authorId    String
  subjectId   String
  productId   String?
  rating      Int
  comment     String?
  isVerified  Boolean  @default(true)
  createdAt   DateTime @default(now())

  order   Order   @relation(fields: [orderId],   references: [id])
  author  User    @relation("ReviewAuthor",  fields: [authorId],  references: [id])
  subject User    @relation("ReviewSubject", fields: [subjectId], references: [id])
  product Product? @relation(fields: [productId], references: [id])

  @@index([subjectId])
  @@map("reviews")
}

// ═══════════════════════════════════════
// NOTIFICATIONS
// ═══════════════════════════════════════

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  data      Json?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("notifications")
}

// ═══════════════════════════════════════
// REWARDS
// ═══════════════════════════════════════

model RewardWallet {
  id             String   @id @default(uuid())
  userId         String   @unique
  balance        Float    @default(0)
  lifetimeEarned Float    @default(0)
  lifetimeUsed   Float    @default(0)
  level          String   @default("seed")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions RewardTransaction[]

  @@map("reward_wallets")
}

model RewardTransaction {
  id          String   @id @default(uuid())
  walletId    String
  amount      Float
  type        String   // earn | redeem | reverse | expire
  source      String   // order_complete | review | referral | signup | etc
  description String
  referenceId String?
  balanceAfter Float
  createdAt   DateTime @default(now())

  wallet RewardWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId])
  @@map("reward_transactions")
}

// ═══════════════════════════════════════
// MARKET INTELLIGENCE
// ═══════════════════════════════════════

model MarketPrice {
  id         String   @id @default(uuid())
  product    String
  categoryId String?
  state      String
  city       String?
  priceMin   Float
  priceMax   Float
  priceAvg   Float
  unit       String   @default("kg")
  source     String   @default("admin")
  recordedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([product])
  @@index([state])
  @@map("market_prices")
}

// ═══════════════════════════════════════
// AUDIT
// ═══════════════════════════════════════

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String
  entity     String
  entityId   String?
  oldValues  Json?
  newValues  Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entity])
  @@map("audit_logs")
}

// ═══════════════════════════════════════
// HAULAGE
// ═══════════════════════════════════════

enum HaulageJobStatus {
  OPEN          // accepting applications
  AWARDED       // a haulage provider has been selected
  IN_TRANSIT    // pickup confirmed, delivery in progress
  DELIVERED     // delivery confirmed
  CANCELLED     // job cancelled
}

enum HaulageApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

model HaulageProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  companyName     String?
  bio             String?
  vehicleType     String   // motorcycle | pickup | small-truck | medium-truck | large-truck | multiple
  vehicleCapacity Float    // max tonnes per trip
  licensePlate    String?
  yearsExperience Int?
  coverageStates  String[] // Nigerian states covered
  coverageRoutes  String?  // free text e.g. "Lagos - Abuja - Kaduna"
  isAvailable     Boolean  @default(true)
  rating          Float    @default(0)
  totalJobs       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications HaulageApplication[]

  @@map("haulage_profiles")
}

model HaulageJob {
  id              String           @id @default(uuid())
  orderId         String           @unique
  status          HaulageJobStatus @default(OPEN)
  awardedToId     String?          // userId of winning haulage provider
  offeredFee      Float            @default(0)
  agreedFee       Float?
  platformCut     Float            @default(0)  // platform commission on haulage fee
  pickupState     String?
  pickupAddress   String?
  deliveryState   String?
  deliveryAddress String?
  cargoSummary    String?
  totalWeight     Float?
  pickupDate      DateTime?
  deliveredAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  order        Order              @relation(fields: [orderId], references: [id])
  awardedTo    User?              @relation("AwardedHaulageJobs", fields: [awardedToId], references: [id])
  applications HaulageApplication[]

  @@index([status])
  @@index([pickupState])
  @@index([deliveryState])
  @@map("haulage_jobs")
}

model HaulageApplication {
  id               String                   @id @default(uuid())
  jobId            String
  applicantId      String
  haulageProfileId String
  status           HaulageApplicationStatus @default(PENDING)
  proposedFee      Float?
  note             String?
  appliedAt        DateTime                 @default(now())
  respondedAt      DateTime?

  job     HaulageJob     @relation(fields: [jobId],            references: [id], onDelete: Cascade)
  applicant User         @relation("HaulageApplications",      fields: [applicantId],      references: [id])
  profile HaulageProfile @relation(fields: [haulageProfileId], references: [id])

  @@unique([jobId, applicantId])
  @@index([applicantId])
  @@map("haulage_applications")
}

// ═══════════════════════════════════════
// FEES & REGISTRATION
// ═══════════════════════════════════════

enum FeeType {
  REGISTRATION      // one-time account activation fee
  TRANSACTION       // % of order value
  HAULAGE_COMMISSION // % of delivery fee
  LISTING           // fee to publish a product (future)
}

enum FeeStatus {
  PENDING
  PAID
  WAIVED
  FAILED
}

model PlatformFee {
  id          String    @id @default(uuid())
  userId      String
  type        FeeType
  amount      Float
  currency    String    @default("NGN")
  status      FeeStatus @default(PENDING)
  referenceId String?   // orderId or jobId or "registration"
  paystackRef String?   @unique
  description String
  dueAt       DateTime?
  paidAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([status])
  @@map("platform_fees")
}

// ═══════════════════════════════════════
// TRANSACTION LEDGER (Section 14)
// Immutable double-entry financial record for every money movement.
// Refunds create reversal entries — records are NEVER deleted.
// ═══════════════════════════════════════

model TransactionLedger {
  id          String           @id @default(uuid())
  orderId     String?
  userId      String?
  userRole    String?          // FARMER | BUYER | TRADER | HAULAGE | PLATFORM
  entryType   LedgerEntryType
  amount      Float            // positive = credit to that party, negative = debit/reversal
  currency    String           @default("NGN")
  status      String           @default("SETTLED") // SETTLED | PENDING | REVERSED
  reference   String?          // payment gateway ref or internal ref
  description String?
  metadata    Json?
  createdAt   DateTime         @default(now())

  order Order? @relation(fields: [orderId], references: [id])
  user  User?  @relation(fields: [userId],  references: [id])

  @@index([orderId])
  @@index([userId])
  @@index([entryType])
  @@index([createdAt])
  @@map("transaction_ledger")
}

// ═══════════════════════════════════════
// SYSTEM SETTINGS (Section 20 & 37)
// Config-driven platform parameters — no hard-coded rates.
// Admin can change marketplace_commission_rate without a code deploy.
// ═══════════════════════════════════════

model SystemSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  updatedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("system_settings")
}

// ═══════════════════════════════════════
// BUYER REQUESTS / RFQ (Section 19)
// ═══════════════════════════════════════

enum RfqStatus {
  OPEN
  RECEIVING_OFFERS
  ACCEPTED
  COMPLETED
  CANCELLED
  EXPIRED
}

model BuyerRequest {
  id              String    @id @default(uuid())
  buyerId         String
  productName     String
  categoryId      String?
  quantityNeeded  Float
  unit            String
  originState     String?
  destinationState String?
  requiredByDate  DateTime?
  qualitySpec     String?
  description     String?
  status          RfqStatus @default(OPEN)
  expiresAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  buyer  User          @relation("BuyerRequests", fields: [buyerId], references: [id])
  offers SellerOffer[]

  @@index([buyerId])
  @@index([status])
  @@map("buyer_requests")
}

model SellerOffer {
  id             String   @id @default(uuid())
  requestId      String
  sellerId       String
  pricePerUnit   Float
  quantityOffered Float
  deliveryDays   Int?
  notes          String?
  isAccepted     Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  request BuyerRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  seller  User         @relation("SellerOffers", fields: [sellerId], references: [id])

  @@index([requestId])
  @@index([sellerId])
  @@map("seller_offers")
}
