# ============================================================
# DG-LETS AGRI MARKET — Backend Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to git
# ============================================================

# ── App ──────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_PREFIX=api
CORS_ORIGIN=http://localhost:8081

# ── Database (PostgreSQL) ────────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:password@localhost:5432/dglets_agri

# ── JWT Auth ─────────────────────────────────────────────────
# Generate strong secrets: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_STRONG_RANDOM_SECRET
JWT_REFRESH_EXPIRES_IN=30d

# ── OTP ──────────────────────────────────────────────────────
OTP_EXPIRES_MINUTES=10
BCRYPT_ROUNDS=12

# ── SMS Provider (OTP delivery) ──────────────────────────────
# Termii (Nigerian SMS provider — recommended)
TERMII_API_KEY=
TERMII_SENDER_ID=DG-LETS
TERMII_BASE_URL=https://api.ng.termii.com

# ── Payment Providers ────────────────────────────────────────
PAYSTACK_SECRET_KEY=sk_test_REPLACE_WITH_YOUR_KEY
PAYSTACK_PUBLIC_KEY=pk_test_REPLACE_WITH_YOUR_KEY
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-REPLACE_WITH_YOUR_KEY
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-REPLACE_WITH_YOUR_KEY

# ── Cloud Storage ────────────────────────────────────────────
# Cloudinary (recommended for images)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── AI Provider ──────────────────────────────────────────────
OPENAI_API_KEY=sk-REPLACE_WITH_YOUR_KEY

# ── Map / Geolocation ────────────────────────────────────────
GOOGLE_MAPS_API_KEY=REPLACE_WITH_YOUR_KEY

# ── DG-LETS MVP Revenue & Pricing Architecture (v1.0) ────────
# Core commission: 5% deducted from seller proceeds (not buyer)
MARKETPLACE_COMMISSION_RATE=0.05

# Payment Processing Fees (gateway pass-through/absorption model)
# Options: percentage | fixed | percentage_with_cap
PAYMENT_FEE_TYPE=percentage_with_cap
PAYMENT_FEE_PERCENTAGE=0.015
PAYMENT_FEE_FIXED=100
PAYMENT_FEE_CAP=2000

# Logistics Coordination Margin (separate from 5% commission)
LOGISTICS_MARGIN_DEFAULT=0.10

# Settlement auto-release window (days)
SETTLEMENT_HOLD_DAYS=3

# One-time registration fees per role (NGN) — 0 = FREE per MVP Spec (Section 3)
REGISTRATION_FEE_FARMER=0
REGISTRATION_FEE_TRADER=0
REGISTRATION_FEE_AGGREGATOR=0
REGISTRATION_FEE_PROCESSOR=0
REGISTRATION_FEE_EXPORTER=0
REGISTRATION_FEE_HAULAGE=0
REGISTRATION_FEE_BUYER=0

# Haulage commission
HAULAGE_COMMISSION_RATE=0.05

# ── Rewards ──────────────────────────────────────────────────
REWARD_TOKEN_NAME=DGR
REWARD_SIGNUP_AMOUNT=10
REWARD_ORDER_COMPLETE_AMOUNT=50
REWARD_REVIEW_AMOUNT=20
REWARD_REFERRAL_AMOUNT=100

# ── Admin ────────────────────────────────────────────────────
ADMIN_EMAIL=admin@dgletsagri.market
